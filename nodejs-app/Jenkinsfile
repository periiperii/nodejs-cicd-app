pipeline {
    agent any

    stages {

        stage('Verify Environment') {
            steps {
                sh '''
                    whoami
                    docker --version
                    aws --version
                    aws sts get-caller-identity
                '''
            }
        }

        stage('Test SSH') {
            steps {
                sshagent(credentials: ['prod-ssh-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ubuntu@13.235.9.106 "hostname && whoami"
                    '''
                }
            }
        }
    }
}